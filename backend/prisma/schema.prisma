// ============================================================
// AquaNexus — Water Plant Management System
// Prisma Schema — 35 Models, 25 Enums
// Database: PostgreSQL
// ============================================================
// BACKEND VALIDATION RULES (DO NOT RELY ONLY ON DB CONSTRAINTS):
// 1. inventory.quantity cannot become negative.
// 2. reservedQuantity <= quantity.
// 3. Dispatch quantity <= available stock.
// 4. Return quantity <= eligible sold/dispatched quantity.
// 5. GoodsReceived quantity <= remaining Production quantity.
// 6. Payment amount <= outstanding Invoice amount.
// 7. Invoice totalAmount = subtotal - discount + tax.
// 8. Payroll netSalary = basicSalary + overtimeAmount - deductions.
// 9. Date validations (e.g., dueDate >= invoiceDate, endDate >= startDate).
// 10. Multi-table stock operations MUST use Prisma transactions.
// 11. GoodsReceived.productId MUST match Production.productId.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ManagerArea {
  PRODUCTION
  STORE
  DISTRIBUTION
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  EMERGENCY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  PRODUCTION_RECEIPT
  STOCK_IN
  STOCK_OUT
  DISPATCH
  RETURN
  DAMAGED
  ADJUSTMENT
}

enum DistributorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DISPATCHED
  DELIVERED
}

enum DispatchStatus {
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  CANCELLED
}

enum ReturnCondition {
  GOOD
  DAMAGED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  SUCCESS
}

// ============================================================
// AUTH & ACCESS (Models 1–6)
// ============================================================

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String     @unique @db.VarChar(50)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  phone        String?    @db.VarChar(20)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz()
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  userRoles          UserRole[]
  managerAssignments ManagerAssignment[]
  userDistributors   UserDistributor[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  employee           Employee?

  productionsCreated Production[]       @relation("ProductionCreator")
  stockTransactions  StockTransaction[] @relation("StockTransactionCreator")
  goodsReceivedBy    GoodsReceived[]    @relation("GoodsReceivedByUser")
  ordersCreated      Order[]            @relation("OrderCreator")
  dispatchesCreated  Dispatch[]         @relation("DispatchCreator")
  salesCreated       Sale[]             @relation("SaleCreator")
  returnsCreated     Return[]           @relation("ReturnCreator")
  paymentsCreated    Payment[]          @relation("PaymentCreator")
  expensesCreated    Expense[]          @relation("ExpenseCreator")
  expensesApproved   Expense[]          @relation("ExpenseApprover")
  leavesApproved     Leave[]            @relation("LeaveApprover")
  overtimeApproved   Overtime[]         @relation("OvertimeApprover")
  payrollProcessed   Payroll[]          @relation("PayrollProcessor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ManagerAssignment {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  area      ManagerArea
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, area])
  @@map("manager_assignments")
}

// ============================================================
// ORGANIZATION (Models 7–11)
// ============================================================

model Department {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  code        String           @unique @db.VarChar(20)
  description String?          @db.VarChar(255)
  status      DepartmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  employees Employee[]

  @@map("departments")
}

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  employeeCode   String         @unique @map("employee_code") @db.VarChar(20)
  userId         String?        @unique @map("user_id") @db.Uuid
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  email          String?        @db.VarChar(255)
  phone          String?        @db.VarChar(20)
  departmentId   String         @map("department_id") @db.Uuid
  designation    String         @db.VarChar(100)
  joiningDate    DateTime       @map("joining_date") @db.Date
  employmentType EmploymentType @map("employment_type")
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  department  Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  attendances Attendance[]
  leaves      Leave[]
  overtimes   Overtime[]
  payrolls    Payroll[]

  @@index([departmentId])
  @@map("employees")
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  status         AttendanceStatus
  checkIn        DateTime?        @map("check_in") @db.Timestamptz()
  checkOut       DateTime?        @map("check_out") @db.Timestamptz()
  remarks        String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@map("attendance")
}

model Leave {
  id         String      @id @default(uuid()) @db.Uuid
  employeeId String      @map("employee_id") @db.Uuid
  leaveType  LeaveType   @map("leave_type")
  startDate  DateTime    @map("start_date") @db.Date
  endDate    DateTime    @map("end_date") @db.Date
  reason     String
  status     LeaveStatus @default(PENDING)
  approvedBy String?     @map("approved_by") @db.Uuid
  approvedAt DateTime?   @map("approved_at") @db.Timestamptz()
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approver User?    @relation("LeaveApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@map("leaves")
}

model Overtime {
  id           String         @id @default(uuid()) @db.Uuid
  employeeId   String         @map("employee_id") @db.Uuid
  overtimeDate DateTime       @map("overtime_date") @db.Date
  hours        Decimal        @db.Decimal(5, 2)
  reason       String?
  status       OvertimeStatus @default(PENDING)
  approvedBy   String?        @map("approved_by") @db.Uuid
  approvedAt   DateTime?      @map("approved_at") @db.Timestamptz()
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approver User?    @relation("OvertimeApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@map("overtime")
}

// ============================================================
// PRODUCTS & PRODUCTION (Models 12–13)
// ============================================================

model Product {
  id           String        @id @default(uuid()) @db.Uuid
  sku          String        @unique @db.VarChar(50)
  name         String        @db.VarChar(200)
  description  String?
  category     String?       @db.VarChar(100)
  unit         String?       @db.VarChar(50)
  sellingPrice Decimal       @map("selling_price") @db.Decimal(12, 2)
  costPrice    Decimal       @map("cost_price") @db.Decimal(12, 2)
  minimumStock Int           @default(0) @map("minimum_stock")
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  productions       Production[]
  inventory         Inventory?
  stockTransactions StockTransaction[]
  goodsReceived     GoodsReceived[]
  orderItems        OrderItem[]
  dispatchItems     DispatchItem[]
  saleItems         SaleItem[]
  returnItems       ReturnItem[]
  distributorStocks DistributorStock[]

  @@map("products")
}

model Production {
  id               String           @id @default(uuid()) @db.Uuid
  productionNumber String           @unique @map("production_number") @db.VarChar(50)
  productId        String           @map("product_id") @db.Uuid
  quantity         Int
  productionDate   DateTime         @map("production_date") @db.Date
  status           ProductionStatus @default(PLANNED)
  batchNumber      String?          @unique @map("batch_number") @db.VarChar(50)
  remarks          String?
  createdBy        String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator       User            @relation("ProductionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  goodsReceived GoodsReceived[]

  @@index([productId])
  @@index([productionDate])
  @@map("production")
}

// ============================================================
// INVENTORY (Models 14–16)
// ============================================================

model Inventory {
  id               String   @id @default(uuid()) @db.Uuid
  productId        String   @unique @map("product_id") @db.Uuid
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  reorderLevel     Int      @default(0) @map("reorder_level")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

model StockTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  productId       String          @map("product_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  quantity        Int
  referenceType   String?         @map("reference_type") @db.VarChar(50)
  referenceId     String?         @map("reference_id") @db.Uuid
  remarks         String?
  createdBy       String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator User    @relation("StockTransactionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([productId])
  @@index([createdAt])
  @@map("stock_transactions")
}

model GoodsReceived {
  id           String   @id @default(uuid()) @db.Uuid
  grnNumber    String   @unique @map("grn_number") @db.VarChar(50)
  productId    String   @map("product_id") @db.Uuid
  productionId String   @map("production_id") @db.Uuid
  quantity     Int
  receivedDate DateTime @map("received_date") @db.Date
  receivedBy   String   @map("received_by") @db.Uuid
  remarks      String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  production Production @relation(fields: [productionId], references: [id], onDelete: Restrict)
  receiver   User       @relation("GoodsReceivedByUser", fields: [receivedBy], references: [id], onDelete: Restrict)

  @@index([productionId])
  @@map("goods_received")
}

// ============================================================
// DISTRIBUTION (Models 17–20)
// ============================================================

model SalesArea {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  code        String           @unique @db.VarChar(20)
  description String?          @db.VarChar(255)
  status      DepartmentStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  distributors Distributor[]

  @@map("sales_areas")
}

model Distributor {
  id              String            @id @default(uuid()) @db.Uuid
  distributorCode String            @unique @map("distributor_code") @db.VarChar(20)
  name            String            @db.VarChar(200)
  email           String?           @db.VarChar(255)
  phone           String?           @db.VarChar(20)
  address         String?
  salesAreaId     String?           @map("sales_area_id") @db.Uuid
  creditLimit     Decimal           @default(0) @map("credit_limit") @db.Decimal(12, 2)
  status          DistributorStatus @default(ACTIVE)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  salesArea        SalesArea?         @relation(fields: [salesAreaId], references: [id], onDelete: SetNull)
  userDistributors UserDistributor[]
  distributorStock DistributorStock[]
  orders           Order[]
  dispatches       Dispatch[]
  sales            Sale[]
  returns          Return[]
  invoices         Invoice[]

  @@index([salesAreaId])
  @@map("distributors")
}

model UserDistributor {
  userId        String   @map("user_id") @db.Uuid
  distributorId String   @map("distributor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@id([userId, distributorId])
  @@map("user_distributors")
}

model DistributorStock {
  id            String   @id @default(uuid()) @db.Uuid
  distributorId String   @map("distributor_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  quantity      Int      @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([distributorId, productId])
  @@map("distributor_stock")
}

// ============================================================
// ORDERS & DISPATCH (Models 21–24)
// ============================================================

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  orderNumber   String      @unique @map("order_number") @db.VarChar(50)
  distributorId String      @map("distributor_id") @db.Uuid
  orderDate     DateTime    @map("order_date") @db.Date
  status        OrderStatus @default(PENDING)
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  discount      Decimal     @default(0) @db.Decimal(12, 2)
  tax           Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes         String?
  createdBy     String      @map("created_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  creator     User        @relation("OrderCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  dispatches  Dispatch[]
  sales       Sale[]
  invoices    Invoice[]

  @@index([distributorId])
  @@index([orderDate])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  tax       Decimal  @default(0) @db.Decimal(12, 2)
  total     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@map("order_items")
}

model Dispatch {
  id             String         @id @default(uuid()) @db.Uuid
  dispatchNumber String         @unique @map("dispatch_number") @db.VarChar(50)
  orderId        String?        @map("order_id") @db.Uuid
  distributorId  String         @map("distributor_id") @db.Uuid
  dispatchDate   DateTime       @map("dispatch_date") @db.Date
  status         DispatchStatus @default(PREPARING)
  createdBy      String         @map("created_by") @db.Uuid
  remarks        String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  distributor   Distributor    @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  creator       User           @relation("DispatchCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  dispatchItems DispatchItem[]
  sales         Sale[]

  @@index([distributorId])
  @@map("dispatches")
}

model DispatchItem {
  id         String   @id @default(uuid()) @db.Uuid
  dispatchId String   @map("dispatch_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, productId])
  @@map("dispatch_items")
}

// ============================================================
// SALES & RETURNS (Models 25–28)
// ============================================================

model Sale {
  id                String     @id @default(uuid()) @db.Uuid
  saleNumber        String     @unique @map("sale_number") @db.VarChar(50)
  orderId           String?    @map("order_id") @db.Uuid
  dispatchId        String?    @map("dispatch_id") @db.Uuid
  distributorId     String     @map("distributor_id") @db.Uuid
  saleDate          DateTime   @map("sale_date") @db.Date
  customerReference String?    @map("customer_reference") @db.VarChar(100)
  subtotal          Decimal    @default(0) @db.Decimal(12, 2)
  discount          Decimal    @default(0) @db.Decimal(12, 2)
  tax               Decimal    @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal    @default(0) @map("total_amount") @db.Decimal(12, 2)
  status            SaleStatus @default(COMPLETED)
  createdBy         String     @map("created_by") @db.Uuid
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  dispatch    Dispatch?   @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  creator     User        @relation("SaleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  saleItems   SaleItem[]
  returns     Return[]
  invoices    Invoice[]

  @@index([distributorId])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid()) @db.Uuid
  saleId    String  @map("sale_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  tax       Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @default(0) @db.Decimal(12, 2)

  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@unique([saleId, productId])
  @@map("sale_items")
}

model Return {
  id            String       @id @default(uuid()) @db.Uuid
  returnNumber  String       @unique @map("return_number") @db.VarChar(50)
  distributorId String       @map("distributor_id") @db.Uuid
  saleId        String?      @map("sale_id") @db.Uuid
  returnDate    DateTime     @map("return_date") @db.Date
  reason        String?
  status        ReturnStatus @default(REQUESTED)
  createdBy     String       @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  distributor Distributor  @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  sale        Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)
  creator     User         @relation("ReturnCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@index([distributorId])
  @@map("returns")
}

model ReturnItem {
  id         String          @id @default(uuid()) @db.Uuid
  returnId   String          @map("return_id") @db.Uuid
  productId  String          @map("product_id") @db.Uuid
  saleItemId String?         @map("sale_item_id") @db.Uuid
  quantity   Int
  condition  ReturnCondition
  remarks    String?

  return_  Return    @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  saleItem SaleItem? @relation(fields: [saleItemId], references: [id], onDelete: SetNull)

  @@unique([returnId, productId])
  @@map("return_items")
}

// ============================================================
// FINANCE (Models 29–33)
// ============================================================

model Supplier {
  id           String         @id @default(uuid()) @db.Uuid
  supplierCode String         @unique @map("supplier_code") @db.VarChar(20)
  name         String         @db.VarChar(200)
  email        String?        @db.VarChar(255)
  phone        String?        @db.VarChar(20)
  address      String?
  status       SupplierStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  expenses Expense[]

  @@map("suppliers")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique @map("invoice_number") @db.VarChar(50)
  distributorId String        @map("distributor_id") @db.Uuid
  orderId       String?       @map("order_id") @db.Uuid
  saleId        String?       @map("sale_id") @db.Uuid
  invoiceDate   DateTime      @map("invoice_date") @db.Date
  dueDate       DateTime      @map("due_date") @db.Date
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sale        Sale?       @relation(fields: [saleId], references: [id], onDelete: SetNull)
  payments    Payment[]

  @@index([distributorId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  paymentNumber   String        @unique @map("payment_number") @db.VarChar(50)
  invoiceId       String        @map("invoice_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime      @map("payment_date") @db.Date
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number") @db.VarChar(100)
  status          PaymentStatus @default(PENDING)
  remarks         String?
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  creator User    @relation("PaymentCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([paymentDate])
  @@map("payments")
}

model Expense {
  id            String        @id @default(uuid()) @db.Uuid
  expenseNumber String        @unique @map("expense_number") @db.VarChar(50)
  category      String        @db.VarChar(100)
  amount        Decimal       @db.Decimal(12, 2)
  expenseDate   DateTime      @map("expense_date") @db.Date
  description   String?
  supplierId    String?       @map("supplier_id") @db.Uuid
  status        ExpenseStatus @default(PENDING)
  createdBy     String        @map("created_by") @db.Uuid
  approvedBy    String?       @map("approved_by") @db.Uuid
  approvedAt    DateTime?     @map("approved_at") @db.Timestamptz()
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  creator  User      @relation("ExpenseCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approver User?     @relation("ExpenseApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([expenseDate])
  @@map("expenses")
}

model Payroll {
  id             String        @id @default(uuid()) @db.Uuid
  employeeId     String        @map("employee_id") @db.Uuid
  payPeriodStart DateTime      @map("pay_period_start") @db.Date
  payPeriodEnd   DateTime      @map("pay_period_end") @db.Date
  basicSalary    Decimal       @map("basic_salary") @db.Decimal(12, 2)
  overtimeAmount Decimal       @default(0) @map("overtime_amount") @db.Decimal(12, 2)
  deductions     Decimal       @default(0) @db.Decimal(12, 2)
  netSalary      Decimal       @map("net_salary") @db.Decimal(12, 2)
  status         PayrollStatus @default(DRAFT)
  processedBy    String?       @map("processed_by") @db.Uuid
  processedAt    DateTime?     @map("processed_at") @db.Timestamptz()
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  processor User?    @relation("PayrollProcessor", fields: [processedBy], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([payPeriodStart, payPeriodEnd])
  @@map("payroll")
}

// ============================================================
// SYSTEM (Models 34–35)
// ============================================================

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  title     String           @db.VarChar(200)
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at") @db.Timestamptz()
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String   @map("entity_id") @db.VarChar(100)
  oldValues  Json?    @map("old_values") @db.JsonB
  newValues  Json?    @map("new_values") @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@map("audit_logs")
}
