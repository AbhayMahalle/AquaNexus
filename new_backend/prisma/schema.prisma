// PROCUREMENT-TO-PAY (P2P) CYCLE (Models 37–46)
// ============================================================

model PurchaseRequisition {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  prNumber            String    @map("pr_number") @db.VarChar(50)
  requestedBy         String    @map("requested_by") @db.Uuid
  supplierId          String?   @map("supplier_id") @db.Uuid
  title               String    @db.VarChar(200)
  priority            String    @default("MEDIUM") @db.VarChar(20)
  requiredByDate      DateTime? @map("required_by_date") @db.Date
  status              String    @default("PENDING_RATE_APPROVAL") @db.VarChar(50)
  
  estimatedTotal      Decimal   @default(0) @map("estimated_total") @db.Decimal(12, 2)
  finalizedTotal      Decimal?  @map("finalized_total") @db.Decimal(12, 2)
  
  rateFinalizedBy     String?   @map("rate_finalized_by") @db.Uuid
  rateFinalizedAt     DateTime? @map("rate_finalized_at") @db.Timestamptz()
  rateApprovalRemarks String?   @map("rate_approval_remarks")
  
  rejectedBy          String?   @map("rejected_by") @db.Uuid
  rejectedAt          DateTime? @map("rejected_at") @db.Timestamptz()
  rejectionReason     String?   @map("rejection_reason")
  
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester           User                       @relation("RequisitionCreator", fields: [requestedBy], references: [id], onDelete: Restrict)
  rateFinalizer       User?                      @relation("RequisitionRateFinalizer", fields: [rateFinalizedBy], references: [id], onDelete: SetNull)
  rejector            User?                      @relation("RequisitionRejector", fields: [rejectedBy], references: [id], onDelete: SetNull)
  supplier            Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items               PurchaseRequisitionItem[]
  purchaseOrders      PurchaseOrder[]

  @@unique([organizationId, prNumber])
  @@index([organizationId])
  @@index([status])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                String              @id @default(uuid()) @db.Uuid
  requisitionId     String              @map("requisition_id") @db.Uuid
  productId         String?             @map("product_id") @db.Uuid
  itemName          String              @map("item_name") @db.VarChar(200)
  requestedQuantity Int                 @map("requested_quantity")
  unit              String              @default("units") @db.VarChar(50)
  targetRate        Decimal?            @map("target_rate") @db.Decimal(12, 2)
  finalizedRate     Decimal?            @map("finalized_rate") @db.Decimal(12, 2)
  finalizedAmount   Decimal?            @map("finalized_amount") @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  requisition       PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product           Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([requisitionId])
  @@map("purchase_requisition_items")
}

model PurchaseOrder {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  poNumber              String              @map("po_number") @db.VarChar(50)
  requisitionId         String?             @map("requisition_id") @db.Uuid
  supplierId            String              @map("supplier_id") @db.Uuid
  issuedBy              String              @map("issued_by") @db.Uuid
  issuedAt              DateTime            @default(now()) @map("issued_at") @db.Timestamptz()
  expectedDeliveryDate  DateTime?           @map("expected_delivery_date") @db.Date
  paymentTerms          String?             @map("payment_terms") @db.VarChar(100)
  deliveryTerms         String?             @map("delivery_terms") @db.VarChar(100)
  subtotal              Decimal             @default(0) @db.Decimal(12, 2)
  taxRate               Decimal             @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount             Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount           Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  
  status                String              @default("ISSUED") @db.VarChar(50)
  vendorAcceptedAt      DateTime?           @map("vendor_accepted_at") @db.Timestamptz()
  vendorRejectedAt      DateTime?           @map("vendor_rejected_at") @db.Timestamptz()
  vendorRejectionReason String?             @map("vendor_rejection_reason")
  notes                 String?
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requisition           PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  supplier              Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  issuer                User                 @relation("POIssuer", fields: [issuedBy], references: [id], onDelete: Restrict)
  items                 PurchaseOrderItem[]
  challans              DeliveryChallan[]
  goodsReceivedNotes    P2PGoodsReceived[]
  vendorInvoices        VendorInvoice[]
  p2pPayments           P2PPayment[]

  @@unique([organizationId, poNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  productId       String?       @map("product_id") @db.Uuid
  itemName        String        @map("item_name") @db.VarChar(200)
  quantity        Int
  unit            String        @default("units") @db.VarChar(50)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  tax             Decimal       @default(0) @db.Decimal(12, 2)
  total           Decimal       @default(0) @db.Decimal(12, 2)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
