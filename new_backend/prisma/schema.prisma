// ============================================================
// AquaNexus — Water Plant Management System
// Prisma Schema — Multi-Tenant Architecture (Phase 1)
// Database: PostgreSQL
// ============================================================
// BACKEND VALIDATION RULES (DO NOT RELY ONLY ON DB CONSTRAINTS):
// 1. inventory.quantity cannot become negative.
// 2. reservedQuantity <= quantity.
// 3. Dispatch quantity <= available stock.
// 4. Return quantity <= eligible sold/dispatched quantity.
// 5. GoodsReceived quantity <= remaining Production quantity.
// 6. Payment amount <= outstanding Invoice amount.
// 7. Invoice totalAmount = subtotal - discount + tax.
// 8. Payroll netSalary = basicSalary + overtimeAmount - deductions.
// 9. Date validations (e.g., dueDate >= invoiceDate, endDate >= startDate).
// 10. Multi-table stock operations MUST use Prisma transactions.
// 11. GoodsReceived.productId MUST match Production.productId.
// 12. Tenant-scoped uniqueness and access isolation enforced at API boundary.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ManagerArea {
  PRODUCTION
  STORE
  DISTRIBUTION
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  TEMPORARY
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  EMERGENCY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum ProductionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransactionType {
  PRODUCTION_RECEIPT
  STOCK_IN
  STOCK_OUT
  DISPATCH
  RETURN
  DAMAGED
  ADJUSTMENT
}

enum DistributorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  DISPATCHED
  DELIVERED
}

enum DispatchStatus {
  PREPARING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  RETURNED
  PARTIALLY_RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  CANCELLED
  INSPECTED
  COMPLETED
}

enum ReturnCondition {
  GOOD
  DAMAGED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  PAID
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  ALERT
  SUCCESS
}

// ============================================================
// TENANCY (Model 1)
// ============================================================

model Organization {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(200)
  slug      String             @unique @db.VarChar(100)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  users             User[]
  departments       Department[]
  employees         Employee[]
  attendances       Attendance[]
  leaves            Leave[]
  overtimes         Overtime[]
  products          Product[]
  productions       Production[]
  inventories       Inventory[]
  stockTransactions StockTransaction[]
  goodsReceived     GoodsReceived[]
  salesAreas        SalesArea[]
  distributors      Distributor[]
  orders            Order[]
  dispatches        Dispatch[]
  sales             Sale[]
  returns           Return[]
  suppliers         Supplier[]
  invoices          Invoice[]
  payments          Payment[]
  expenses          Expense[]
  payrolls          Payroll[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  deliveryChallans     DeliveryChallan[]
  p2pGoodsReceived     P2PGoodsReceived[]
  vendorInvoices       VendorInvoice[]
  p2pPayments          P2PPayment[]

  @@map("organizations")
}

// ============================================================
// AUTH & ACCESS (Models 2–7)
// ============================================================

model User {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  isSuperAdmin   Boolean       @default(false) @map("is_super_admin")
  superAdminSlot String?       @unique @map("super_admin_slot") @db.VarChar(20)
  username       String        @unique @db.VarChar(50)
  email          String        @unique @db.VarChar(255)
  passwordHash   String        @map("password_hash") @db.VarChar(255)
  firstName      String        @map("first_name") @db.VarChar(100)
  lastName       String        @map("last_name") @db.VarChar(100)
  phone          String?       @db.VarChar(20)
  status         UserStatus    @default(ACTIVE)
  lastLoginAt    DateTime?     @map("last_login_at") @db.Timestamptz()
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles          UserRole[]
  managerAssignments ManagerAssignment[]
  userDistributors   UserDistributor[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  employee           Employee?

  productionsCreated Production[]       @relation("ProductionCreator")
  stockTransactions  StockTransaction[] @relation("StockTransactionCreator")
  goodsReceivedBy    GoodsReceived[]    @relation("GoodsReceivedByUser")
  ordersCreated      Order[]            @relation("OrderCreator")
  dispatchesCreated  Dispatch[]         @relation("DispatchCreator")
  salesCreated       Sale[]             @relation("SaleCreator")
  returnsCreated     Return[]           @relation("ReturnCreator")
  paymentsCreated    Payment[]          @relation("PaymentCreator")
  expensesCreated    Expense[]          @relation("ExpenseCreator")
  expensesApproved   Expense[]          @relation("ExpenseApprover")
  leavesApproved     Leave[]            @relation("LeaveApprover")
  overtimeApproved   Overtime[]         @relation("OvertimeApprover")
  payrollProcessed   Payroll[]          @relation("PayrollProcessor")

  purchaseRequisitionsCreated       PurchaseRequisition[] @relation("RequisitionCreator")
  purchaseRequisitionsRateFinalized PurchaseRequisition[] @relation("RequisitionRateFinalizer")
  purchaseRequisitionsRejected      PurchaseRequisition[] @relation("RequisitionRejector")
  purchaseOrdersIssued              PurchaseOrder[]       @relation("POIssuer")
  p2pGoodsReceivedByUser            P2PGoodsReceived[]    @relation("P2PGoodsReceivedByUser")
  vendorInvoicesReviewed            VendorInvoice[]       @relation("InvoiceReviewer")
  p2pPaymentsCreated                P2PPayment[]          @relation("P2PPaymentCreator")

  @@index([organizationId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ManagerAssignment {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  area      ManagerArea
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, area])
  @@map("manager_assignments")
}

// ============================================================
// ORGANIZATION & HR (Models 8–12)
// ============================================================

model Department {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(100)
  code           String           @db.VarChar(20)
  description    String?          @db.VarChar(255)
  status         DepartmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees    Employee[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

model Employee {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  employeeCode   String         @map("employee_code") @db.VarChar(20)
  userId         String?        @unique @map("user_id") @db.Uuid
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  email          String?        @db.VarChar(255)
  phone          String?        @db.VarChar(20)
  departmentId   String         @map("department_id") @db.Uuid
  designation    String         @db.VarChar(100)
  joiningDate    DateTime       @map("joining_date") @db.Date
  employmentType EmploymentType @map("employment_type")
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  attendances  Attendance[]
  leaves       Leave[]
  overtimes    Overtime[]
  payrolls     Payroll[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
  @@index([departmentId])
  @@map("employees")
}

model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  employeeId     String           @map("employee_id") @db.Uuid
  attendanceDate DateTime         @map("attendance_date") @db.Date
  status         AttendanceStatus
  checkIn        DateTime?        @map("check_in") @db.Timestamptz()
  checkOut       DateTime?        @map("check_out") @db.Timestamptz()
  remarks        String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, attendanceDate])
  @@index([organizationId])
  @@index([attendanceDate])
  @@map("attendance")
}

model Leave {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  employeeId     String      @map("employee_id") @db.Uuid
  leaveType      LeaveType   @map("leave_type")
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  reason         String
  status         LeaveStatus @default(PENDING)
  approvedBy     String?     @map("approved_by") @db.Uuid
  approvedAt     DateTime?   @map("approved_at") @db.Timestamptz()
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approver     User?        @relation("LeaveApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([employeeId])
  @@map("leaves")
}

model Overtime {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  employeeId     String         @map("employee_id") @db.Uuid
  overtimeDate   DateTime       @map("overtime_date") @db.Date
  hours          Decimal        @db.Decimal(5, 2)
  reason         String?
  status         OvertimeStatus @default(PENDING)
  approvedBy     String?        @map("approved_by") @db.Uuid
  approvedAt     DateTime?      @map("approved_at") @db.Timestamptz()
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approver     User?        @relation("OvertimeApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([employeeId])
  @@map("overtime")
}

// ============================================================
// PRODUCTS & PRODUCTION (Models 13–14)
// ============================================================

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  sku            String        @db.VarChar(50)
  name           String        @db.VarChar(200)
  description    String?
  category       String?       @db.VarChar(100)
  unit           String?       @db.VarChar(50)
  sellingPrice   Decimal       @map("selling_price") @db.Decimal(12, 2)
  costPrice      Decimal       @map("cost_price") @db.Decimal(12, 2)
  minimumStock   Int           @default(0) @map("minimum_stock")
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  productions       Production[]
  inventory         Inventory?
  stockTransactions StockTransaction[]
  goodsReceived     GoodsReceived[]
  orderItems        OrderItem[]
  dispatchItems     DispatchItem[]
  saleItems         SaleItem[]
  returnItems       ReturnItem[]
  distributorStocks DistributorStock[]

  purchaseRequisitionItems PurchaseRequisitionItem[]
  purchaseOrderItems       PurchaseOrderItem[]
  p2pGoodsReceivedItems    P2PGoodsReceivedItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("products")
}

model Production {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  productionNumber String           @map("production_number") @db.VarChar(50)
  productId        String           @map("product_id") @db.Uuid
  quantity         Int
  productionDate   DateTime         @map("production_date") @db.Date
  status           ProductionStatus @default(PLANNED)
  batchNumber      String?          @map("batch_number") @db.VarChar(50)
  remarks          String?
  createdBy        String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator       User            @relation("ProductionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  goodsReceived GoodsReceived[]

  @@unique([organizationId, productionNumber])
  @@unique([organizationId, batchNumber])
  @@index([organizationId])
  @@index([productId])
  @@index([productionDate])
  @@map("production")
}

// ============================================================
// INVENTORY (Models 15–17)
// ============================================================

model Inventory {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  productId        String   @unique @map("product_id") @db.Uuid
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  reorderLevel     Int      @default(0) @map("reorder_level")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("inventory")
}

model StockTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  productId       String          @map("product_id") @db.Uuid
  transactionType TransactionType @map("transaction_type")
  quantity        Int
  referenceType   String?         @map("reference_type") @db.VarChar(50)
  referenceId     String?         @map("reference_id") @db.Uuid
  status          String?         @default("COMPLETED") @db.VarChar(50)
  remarks         String?
  createdBy       String          @map("created_by") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  creator      User         @relation("StockTransactionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([productId])
  @@index([createdAt])
  @@map("stock_transactions")
}

model GoodsReceived {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  grnNumber      String   @map("grn_number") @db.VarChar(50)
  productId      String   @map("product_id") @db.Uuid
  productionId   String   @map("production_id") @db.Uuid
  quantity       Int
  receivedDate   DateTime @map("received_date") @db.Date
  status         String   @default("RECEIVED") @db.VarChar(50)
  receivedBy     String   @map("received_by") @db.Uuid
  remarks        String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  production   Production   @relation(fields: [productionId], references: [id], onDelete: Restrict)
  receiver     User         @relation("GoodsReceivedByUser", fields: [receivedBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, grnNumber])
  @@index([organizationId])
  @@index([productionId])
  @@map("goods_received")
}

// ============================================================
// DISTRIBUTION (Models 18–21)
// ============================================================

model SalesArea {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(100)
  code           String           @db.VarChar(20)
  description    String?          @db.VarChar(255)
  status         DepartmentStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  distributors Distributor[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("sales_areas")
}

model Distributor {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  distributorCode String            @map("distributor_code") @db.VarChar(20)
  name            String            @db.VarChar(200)
  email           String?           @db.VarChar(255)
  phone           String?           @db.VarChar(20)
  address         String?
  salesAreaId     String?           @map("sales_area_id") @db.Uuid
  creditLimit     Decimal           @default(0) @map("credit_limit") @db.Decimal(12, 2)
  status          DistributorStatus @default(ACTIVE)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  salesArea        SalesArea?         @relation(fields: [salesAreaId], references: [id], onDelete: SetNull)
  userDistributors UserDistributor[]
  distributorStock DistributorStock[]
  orders           Order[]
  dispatches       Dispatch[]
  sales            Sale[]
  returns          Return[]
  invoices         Invoice[]

  @@unique([organizationId, distributorCode])
  @@index([organizationId])
  @@index([salesAreaId])
  @@map("distributors")
}

model UserDistributor {
  userId        String   @map("user_id") @db.Uuid
  distributorId String   @map("distributor_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@id([userId, distributorId])
  @@map("user_distributors")
}

model DistributorStock {
  id            String   @id @default(uuid()) @db.Uuid
  distributorId String   @map("distributor_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  quantity      Int      @default(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([distributorId, productId])
  @@map("distributor_stock")
}

// ============================================================
// ORDERS & DISPATCH (Models 22–25)
// ============================================================

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  orderNumber    String      @map("order_number") @db.VarChar(50)
  distributorId  String      @map("distributor_id") @db.Uuid
  orderDate      DateTime    @map("order_date") @db.Date
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  discount       Decimal     @default(0) @db.Decimal(12, 2)
  tax            Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  notes          String?
  createdBy      String      @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
