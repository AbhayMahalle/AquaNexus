model DeliveryChallanItem {
  id                 String          @id @default(uuid()) @db.Uuid
  challanId          String          @map("challan_id") @db.Uuid
  itemName           String          @map("item_name") @db.VarChar(200)
  dispatchedQuantity Int             @map("dispatched_quantity")
  unit               String          @default("units") @db.VarChar(50)
  remarks            String?
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  challan            DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)

  @@index([challanId])
  @@map("delivery_challan_items")
}

model P2PGoodsReceived {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  purchaseOrderId    String                 @map("purchase_order_id") @db.Uuid
  challanId          String?                @map("challan_id") @db.Uuid
  grnNumber          String                 @map("grn_number") @db.VarChar(50)
  receivedDate       DateTime               @map("received_date") @db.Date
  receivedBy         String                 @map("received_by") @db.Uuid
  inspectionRemarks  String?                @map("inspection_remarks")
  status             String                 @default("ACCEPTED") @db.VarChar(50)
  rejectionReason    String?                @map("rejection_reason")
  rejectedAt         DateTime?              @map("rejected_at") @db.Timestamptz()
  inventoryUpdated   Boolean                @default(false) @map("inventory_updated")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz()

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder      PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  challan            DeliveryChallan?       @relation(fields: [challanId], references: [id], onDelete: SetNull)
  receiver           User                   @relation("P2PGoodsReceivedByUser", fields: [receivedBy], references: [id], onDelete: Restrict)
  items              P2PGoodsReceivedItem[]
  vendorInvoices     VendorInvoice[]

  @@unique([organizationId, grnNumber])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@map("p2p_goods_received")
}

model P2PGoodsReceivedItem {
  id                 String           @id @default(uuid()) @db.Uuid
  grnId              String           @map("grn_id") @db.Uuid
  productId          String?          @map("product_id") @db.Uuid
  itemName           String           @map("item_name") @db.VarChar(200)
  orderedQuantity    Int              @map("ordered_quantity")
  dispatchedQuantity Int              @map("dispatched_quantity")
  receivedQuantity   Int              @map("received_quantity")
  acceptedQuantity   Int              @map("accepted_quantity")
  rejectedQuantity   Int              @default(0) @map("rejected_quantity")
  unit               String           @default("units") @db.VarChar(50)
  condition          String?          @db.VarChar(50)
  remarks            String?
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  grn                P2PGoodsReceived @relation(fields: [grnId], references: [id], onDelete: Cascade)
  product            Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([grnId])
  @@map("p2p_goods_received_items")
}

model VendorInvoice {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @map("organization_id") @db.Uuid
  purchaseOrderId     String           @map("purchase_order_id") @db.Uuid
  supplierId          String           @map("supplier_id") @db.Uuid
  grnId               String?          @map("grn_id") @db.Uuid
  invoiceNumber       String           @map("invoice_number") @db.VarChar(50)
  invoiceDate         DateTime         @map("invoice_date") @db.Date
  dueDate             DateTime         @map("due_date") @db.Date
  subtotal            Decimal          @default(0) @db.Decimal(12, 2)
  taxAmount           Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount         Decimal          @default(0) @map("total_amount") @db.Decimal(12, 2)
  status              String           @default("SUBMITTED") @db.VarChar(50)
  accountantRemarks   String?          @map("accountant_remarks")
  reviewedBy          String?          @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?        @map("reviewed_at") @db.Timestamptz()
  rejectionReason     String?          @map("rejection_reason")
  threeWayMatchStatus String?          @default("MATCHED") @map("three_way_match_status") @db.VarChar(50)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  purchaseOrder       PurchaseOrder    @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  supplier            Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  grn                 P2PGoodsReceived? @relation(fields: [grnId], references: [id], onDelete: SetNull)
  reviewer            User?            @relation("InvoiceReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  payments            P2PPayment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([purchaseOrderId])
  @@map("vendor_invoices")
}

model P2PPayment {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  vendorInvoiceId String        @map("vendor_invoice_id") @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  paymentNumber   String        @map("payment_number") @db.VarChar(50)
  amount          Decimal       @db.Decimal(12, 2)
  paymentDate     DateTime      @map("payment_date") @db.Date
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number") @db.VarChar(100)
  status          PaymentStatus @default(PENDING)
  remarks         String?
  paidBy          String        @map("paid_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vendorInvoice   VendorInvoice @relation(fields: [vendorInvoiceId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  payer           User          @relation("P2PPaymentCreator", fields: [paidBy], references: [id], onDelete: Restrict)

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([vendorInvoiceId])
  @@map("p2p_payments")
}


