# ============================================================
# AquaNexus Backend — Environment Variables
# ============================================================
# Copy this file to .env and configure your local settings.
# NEVER commit your actual .env containing secrets to git.
# ============================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection URL (Prisma ORM)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/aquanexus?schema=public"

# JWT Authentication Secret Key
JWT_SECRET="aquanexus_super_secret_jwt_key_2026_change_in_production"